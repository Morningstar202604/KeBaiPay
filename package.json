{
  "name": "kebaipay",
  "version": "0.3.2",
  "description": "KeBaiPay 科佰支付 - 个人钱包 + 商户收款 + 开放 API + 多平台对账聚合 + AI 智能体层平台（NestJS 11 + Prisma 7 + PostgreSQL 16 + Redis 7 + Vercel AI SDK v7 + MCP）",
  "author": "KeBaiPay Contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:resolve": "prisma migrate resolve",
    "migrate:reset": "prisma migrate reset",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "version:sync": "node scripts/version-sync.mjs",
    "version:check": "node scripts/version-sync.mjs --check",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','node_modules/.cache'])fs.rmSync(p,{recursive:true,force:true})\"",
    "check:external": "node scripts/check-external.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ai": "^7.0.107",
    "alipay-sdk": "^4.14.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tencentcloud-sdk-nodejs-sms": "^4.1.306",
    "wechatpay-node-v3": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "jest": "^30.5.2",
    "playwright": "^1.63.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0",
    "multer": "^2.3.0",
    "mailparser": {
      "nodemailer": "^10.0.10"
    }
  },
  "keywords": [
    "nestjs",
    "payment",
    "payment-gateway",
    "payment-processing",
    "payment-platform",
    "wallet",
    "prisma",
    "postgresql",
    "redis",
    "wechat-pay",
    "alipay",
    "stripe",
    "paypal",
    "open-api",
    "reconciliation",
    "fintech",
    "ai-agent",
    "ai-sdk",
    "mcp",
    "llm",
    "typescript",
    "open-source",
    "escrow",
    "risk-control",
    "self-hosted"
  ],
  "homepage": "https://github.com/x33834/KeBaiPay",
  "repository": {
    "type": "git",
    "url": "https://github.com/x33834/KeBaiPay.git"
  },
  "bugs": {
    "url": "https://github.com/x33834/KeBaiPay/issues"
  }
}