node_modules
dist
coverage
# 递归排除所有层级的 node_modules（含 web*/ 子项目，防止构建上下文膨胀）
**/node_modules

# 前端子项目（镜像只托管其 dist；由 CI 单独构建后放置，不在后端镜像内构建）
web
web-admin
web-h5

# 演示素材（视频/截图体积大且运行时不需要）
demo

# 运行时数据目录
data

# 环境变量与密钥
.env
.env.*
!.env.example

# 测试与 e2e（运行时不需要）
*.spec.ts
*.spec.js
test/
__tests__/
jest.config.js
jest-e2e.config.js

# 文档与 IDE
.vscode
.idea
README.md
docs
*.md
!prisma/*.md

# 版本控制与 CI
.git
.gitignore
.github
.gitlab-ci.yml

# 日志、临时、缓存
*.log
*.db
*.tmp
*.swp
*.bak
npm-debug.log*
yarn-error.log*
.cache
.npm/

# 运维/部署文件（镜像构建不需要）
docker-compose*.yml
start.sh
start.bat
HANDOVER.md
